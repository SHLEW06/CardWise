node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example
.firebase
firebase-debug.log
.DS_Store
.vscode/*
!.vscode/extensions.json

# card faces: issuer photos in public/cards/ are committed and published
# (owner's decision 2026-11-23, non-commercial project — see docs/THIRD_PARTY.md)

# generated from public/cards/ by scripts/build-card-art-manifest.mjs (pre-dev/build/test)
src/data/cardArtManifest.js

# fonts: fetched by `npm run fonts` (Boska, Switzer, Archivo Expanded — free
# for commercial use, see docs/THIRD_PARTY.md); kept out of git by the v6/v7 rule
public/fonts/

# photo backgrounds: only the CC0 photos built by scripts/backgrounds/build.mjs
# are published (see docs/THIRD_PARTY.md); any other file in this folder
# (focal-*, avif/jpg/png, AI renders) stays local until it is licensed
public/backgrounds/*
!public/backgrounds/home.webp
!public/backgrounds/checkout.webp
!public/backgrounds/offers.webp
!public/backgrounds/lab.webp
!public/backgrounds/explore.webp
!public/backgrounds/survey.webp
!public/backgrounds/profile.webp

# vite writes these next to the config when it bundles it
vite.config.js.timestamp-*

# review screenshots (contain personal-use card art)
screenshots/
docs/screenshots/

# bank captures: HARs hold session cookies; calibration-raw holds account data
connector/data/
*.har
connector/calibration/*.suggested.json

# route-data downloads (npm run routes)
.cache/

# v7f: hotel lists imported for personal use (awardhelper, edithotelsearch) — not public until the site owners agree
src/data/hotels/properties.local.generated.js
# owner workbook and its derived prices: local only (redistribution not cleared;
# the public site ships facts only via programHotels.public.json)
src/data/hotels/workbook.generated.json
docs/data/hotel-workbook/

# Independent routing oracle outputs (scripts/oracle)
scripts/oracle/scenarios.json
scripts/oracle/results.json
