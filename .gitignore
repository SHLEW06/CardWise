node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example
.firebase
firebase-debug.log
.DS_Store
.vscode/*
!.vscode/extensions.json

# real card faces are personal/copyrighted — keep them local
public/cards/*
!public/cards/README.md

!public/cards/art-urls.example.txt

# generated from public/cards/ by scripts/build-card-art-manifest.mjs (pre-dev/build/test)
src/data/cardArtManifest.js

# fonts: fetched by `npm run fonts` (Boska, Switzer, Archivo Expanded — free
# for commercial use, see docs/THIRD_PARTY.md); kept out of git by the v6/v7 rule
public/fonts/

# generated photo backgrounds — personal use only until licensed
public/backgrounds/

# vite writes these next to the config when it bundles it
vite.config.js.timestamp-*

# review screenshots (contain personal-use card art)
screenshots/

# bank captures: HARs hold session cookies; calibration-raw holds account data
connector/data/
*.har
connector/calibration/*.suggested.json

# route-data downloads (npm run routes)
.cache/
