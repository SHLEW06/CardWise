{
  "hosting": {
    "site": "credit-card-optimizer-19762",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "backgrounds/focal-*", "backgrounds/*.@(avif|jpg|jpeg|png)"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
