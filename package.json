{
  "name": "cardwise",
  "private": true,
  "version": "4.0.0-alpha.1",
  "type": "module",
  "description": "CardWise — a personalized credit-card value-maximizing strategy app. Anchors recommendations to your airport, routes, spend, and redemption goals, valuing points through real transfer partners.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/check-dist-secrets.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "pretest": "node scripts/build-card-art-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/build-card-art-manifest.mjs",
    "prebuild": "node scripts/build-card-art-manifest.mjs",
    "art": "node scripts/build-card-art-manifest.mjs",
    "art:missing": "node scripts/build-card-art-manifest.mjs --missing",
    "art:fetch": "node scripts/fetch-card-art.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "art:sources": "node scripts/card-art-sources.mjs",
    "connector": "npm --prefix connector start",
    "dev:all": "node scripts/dev-all.mjs",
    "calibrate": "npm --prefix connector run calibrate --",
    "brands": "node scripts/build-brands.mjs",
    "test:connector": "CHROME_CHANNEL=${CHROME_CHANNEL:-chrome} npm --prefix connector test",
    "test:extension": "node --test extension/test/*.test.js",
    "test:all": "npm test && npm run test:extension && npm run test:connector",
    "extension:calibrations": "node extension/scripts/sync-calibrations.mjs",
    "audit:cards": "node scripts/card-audit.mjs",
    "golden": "node scripts/golden-report.mjs",
    "routes": "node scripts/build-routes.mjs",
    "hotels": "node scripts/build-premium-hotels.mjs",
    "hotel-db": "node scripts/build-hotel-db.mjs",
    "audit:v7c": "node scripts/card-audit-v7c.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "firebase": "^12.15.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "vite": "^5.3.4",
    "vitest": "^4.1.9"
  }
}
